{
  "name": "palworld-server",
  "version": "1.0.0",
  "private": true,
  "description": "Infrastructure-as-code for an on-demand Palworld dedicated server on AWS",
  "bin": {
    "palworld": "bin/palworld.js"
  },
  "scripts": {
